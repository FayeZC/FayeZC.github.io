---
import '../styles/spatial.css'
import { profile } from '../data/site.js'
import { sprite } from '../lib/sprite.js'
import { ui, pick, localizePath, htmlLang } from '../i18n/index.js'
const { lang = 'en', path = '/', title, description } = Astro.props
const home = path === '/'
const pageTitle = title ? `${title} · ${pick(profile.name,lang)}` : pick(profile.name,lang)
const name = pick(profile.name, lang)
const t = ui[lang]
---
<!doctype html>
<html lang={htmlLang[lang]}>
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description ?? pick(profile.tagline, lang).join(' ')} />
<link rel="canonical" href={new URL(localizePath(path, lang), Astro.site)} />
<link rel="alternate" hreflang="en" href={new URL(localizePath(path, 'en'), Astro.site)} /><link rel="alternate" hreflang="zh" href={new URL(localizePath(path, 'zh'), Astro.site)} /><link rel="alternate" hreflang="x-default" href={new URL(localizePath(path, 'en'), Astro.site)} />
<link rel="icon" type="image/png" sizes="32x32" href="/logos/triceratops-silver-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/logos/triceratops-silver-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/logos/triceratops-silver-180.png" />
<meta name="theme-color" content="#ffffff" /><meta property="og:title" content={name} /><meta property="og:description" content={pick(profile.tagline, lang)[0]} /><meta property="og:type" content="website" />
</head>
<body class:list={["spatial-home", {"spatial-document": !home}]}>
<a class="skip" href="#content">{lang === 'en' ? 'Skip to content' : '跳转到正文'}</a>
<header class="void-header">
<a href={localizePath('/', lang)} class="identity" aria-label={name}><span>{home ? 'FZ / INDEX' : name}</span><span>{lang === 'en' ? 'Computer science / Research' : '计算机科学 / 研究'}</span></a>
<nav aria-label={lang === 'en' ? 'Main navigation' : '主导航'}><a href={localizePath('/',lang)+'#biography'}>{t.about}</a><a href={localizePath('/publications', lang)} aria-current={path.startsWith('/publications') ? 'page' : undefined}>{t.nav.publications}</a><a href={localizePath('/blog', lang)} aria-current={path.startsWith('/blog') ? 'page' : undefined}>{t.nav.blog}</a><a href={localizePath('/cv', lang)} aria-current={path === '/cv' ? 'page' : undefined}>CV</a></nav>
</header>
<main id="content" class:list={{"document-content": !home}}><slot /></main>
<footer class="void-footer"><span>© {new Date().getFullYear()} {name}</span><span class="footer-note">{t.footer}<img {...sprite('trike-45')} class="footer-trike" alt="" aria-hidden="true" /></span><a href="#content">{lang === 'en' ? 'Back to top ↑' : '返回顶部 ↑'}</a></footer>
</body>
</html>
