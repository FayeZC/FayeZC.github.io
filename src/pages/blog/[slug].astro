---
import BlogPost from '../../components/pages/BlogPost.astro'
import { postsFor, slugOf } from '../../lib/blog.js'

export async function getStaticPaths() {
  const posts = await postsFor('en')
  return posts.map((post) => ({ params: { slug: slugOf(post.id) }, props: { post } }))
}

const { post } = Astro.props
---

<BlogPost lang="en" post={post} />
