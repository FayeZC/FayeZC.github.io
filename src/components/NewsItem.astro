---
// One row of the News list. Shared by the visible list and the part behind
// the More toggle, so the two cannot drift apart.
import { pick } from '../i18n/index.js'

const { item, lang } = Astro.props
---

<li>
  <time datetime={item.date}>{item.date}</time>
  <span>
    {pick(item.body, lang)}
    {item.logo && <img class="news-logo" src={item.logo.src} alt={pick(item.logo.alt, lang)} />}
  </span>
</li>
