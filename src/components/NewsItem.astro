---
// One row of the News list. `hidden` marks the older rows that the More button
// under the panel reveals.
import { pick } from '../i18n/index.js'

const { item, lang, hidden = false } = Astro.props
---

<li hidden={hidden} data-older={hidden ? '' : undefined}>
  <time datetime={item.date}>{item.date}</time>
  <span>
    {pick(item.body, lang)}
    {item.logo && <img class="news-logo" src={item.logo.src} alt={pick(item.logo.alt, lang)} />}
  </span>
</li>
