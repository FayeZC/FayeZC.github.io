---
import Spatial from '../../layouts/Spatial.astro'
import EmailReveal from '../EmailReveal.astro'
import NewsItem from '../NewsItem.astro'
import { profile, education, interests, news, members } from '../../data/site.js'
import { publications, me } from '../../data/publications.js'
import { postsFor, slugOf, formatDate } from '../../lib/blog.js'
import { ui, pick, localizePath } from '../../i18n/index.js'
import { sprite, photo } from '../../lib/sprite.js'
const { lang } = Astro.props
const t = ui[lang], en = lang === 'en'
const posts = (await postsFor(lang)).slice(0,3)
const papers = publications.filter(p => p.selected !== false).slice(0,4)
const latestNews = news.slice(0,5), olderNews = news.slice(5)
---
<Spatial lang={lang}>
<section class="void-field" aria-label={en ? 'Research overview' : '研究概览'}>
 <div class="spatial-art" aria-hidden="true">
  <img class="field-lines" src="/spatial/field-lines.svg" alt="" />
  <div class="artifact disc" data-depth="22"><img src="/spatial/disc.svg" width="480" height="330" alt="" /><span>OPTICAL / 01</span></div>
  <div class="artifact crt" data-depth="9"><img src="/spatial/infinity-user.webp" width="640" height="313" alt="" /><span>INFINITY / 02</span></div>
  <div class="artifact network" data-depth="15"><img src="/spatial/atom-user.webp" width="640" height="553" alt="" /></div>
  <div class="artifact ring" data-depth="34"><img src="/spatial/chrome-ring.webp" width="440" height="440" alt="" /><span>ORBIT / 03</span></div>
 </div>
 <nav class="field-contents" aria-label={en ? 'Contents' : '目录'}>
  <ol>{[
    ['01', t.about, '#biography'],
    ['02', t.news, '#news'],
    ['03', t.interests, '#research'],
    ['04', t.education, '#education'],
    ['05', t.nav.publications, '#publications'],
    ['06', t.nav.blog, '#blog'],
    ['07', t.members, '#members'],
    ['08', t.nav.cv, localizePath('/cv',lang)],
    ['09', en ? 'Contact' : '联系', '#contact'],
  ].map(([number,label,href])=><li><a href={href}><span>{number}</span>{label}<span class="contents-arrow">↗</span></a></li>)}</ol>
 </nav>
 <div class="field-coordinate" aria-hidden="true">[ FZ / 01 ]<br />{en ? 'NEW YORK, NY' : '纽约'}</div>
 <div class="field-intro"><p class="index-label">01 / {t.about}</p><h1>{pick(profile.name, lang)}</h1><p>{pick(profile.title, lang)}<br />{pick(profile.affiliation, lang)}</p><a class="text-link" href="#biography">{en ? 'A little about me' : '了解更多'} ↗</a></div>
 <div class="field-research"><p class="index-label">03 / {t.interests}</p><h2>{en ? <>Security & privacy.<br />Agentic AI systems.</> : <>安全与隐私。<br />智能体 AI 系统。</>}</h2><a class="text-link" href="#research">{en ? 'Explore research interests' : '查看研究兴趣'} ↗</a></div>
 <div class="field-bottom"><button class="motion-control" type="button" aria-pressed="false" data-on={en ? 'Pause motion' : '暂停动态'} data-off={en ? 'Enable motion' : '启用动态'}>{en ? 'Pause motion' : '暂停动态'}</button></div>
</section>
<div class="archive">
<section id="biography" class="text-node biography-node"><div class="node-label"><span class="index-label">01 / {t.about}</span><span class="cross" aria-hidden="true">+</span></div><div class="node-content"><p>{pick(profile.intro,lang).map(part=>typeof part==='string'?part:part.href?<a href={part.href}>{part.text}</a>:<span class:list={{"nemo-mark":part.mark}}>{part.text}</span>)}</p>{pick(profile.bio,lang).map(p=><p>{p}</p>)}<p>{pick(profile.collab,lang)}</p><div class="about-fish" aria-hidden="true"><img {...sprite('nemo-64')} alt="" /></div><div id="about-contact" class="about-contact"><EmailReveal payload={profile.emailPayload} label={t.revealEmail} fallback={t.emailFallback} copyLabel={t.copyEmail} copiedLabel={t.emailCopied} selectLabel={t.emailSelectToCopy}/><div class="about-socials">{profile.links.map(link=><a href={link.internal?localizePath(link.href,lang):link.href}>{pick(link.label,lang)} ↗</a>)}</div></div></div></section>
<section id="news" class="text-node news-node"><div class="node-label"><span class="index-label">02 / {t.news}</span></div><div class="node-content"><ul class="news" id="news-list">{latestNews.map(item=><NewsItem item={item} lang={lang}/>)}{olderNews.map(item=><NewsItem item={item} lang={lang} hidden/>)}</ul>{olderNews.length>0&&<button class="news-toggle text-link" type="button" aria-expanded="false" aria-controls="news-list" data-more={t.moreNews} data-less={t.lessNews}>{t.moreNews} ↓</button>}</div></section>
<section id="research" class="text-node research-node"><div class="node-label"><span class="index-label">03 / {t.interests}</span><img src="/spatial/chip-user.webp" width="560" height="461" alt="" loading="lazy" aria-hidden="true" /></div><div class="node-content"><ul class="research-list">{interests.map((item,i)=><li><span class="index-label">{String(i+1).padStart(2,'0')}</span>{pick(item,lang)}</li>)}</ul></div></section>
<section id="education" class="text-node education-node"><div class="node-label"><span class="index-label">04 / {t.education}</span></div><div class="node-content"><ul class="education-list">{education.map(item=><li><p class="index-label">{pick(item.when,lang)}</p><h3>{pick(item.school,lang)}</h3><p>{pick(item.degree,lang)}<br /><span class="muted">{pick(item.where,lang)}</span></p></li>)}</ul></div></section>
<section id="publications" class="text-node publications-node"><div class="node-label"><span class="index-label">05 / {t.selectedPublications}</span><a href={localizePath('/publications',lang)} class="text-link">{en ? 'All publications' : '全部论文'} ↗</a><img class="publication-cube" src="/spatial/cube-user.webp" width="560" height="623" alt="" aria-hidden="true" loading="lazy" /></div><div class="node-content"><ol class="publication-list">{papers.map(p=><li><p class="index-label">{p.year} / {p.short}</p><h3>{p.title}</h3><p class="authors">{p.authors.map((a,i)=><>{i>0&&', '}{a===me?<strong class="author-self">{a}</strong>:a}</>)}</p><p class="venue">{p.venue}</p><div class="paper-links">{Object.entries(p.links).map(([label,href])=><a href={href}>{label} ↗</a>)}</div></li>)}</ol></div></section>
<section id="blog" class="text-node blog-node"><div class="node-label"><span class="index-label">06 / {t.nav.blog}</span><a href={localizePath('/blog',lang)} class="text-link">{en ? 'All posts' : '全部文章'} ↗</a></div><div class="node-content">{posts.map(post=><article class="post-entry"><p class="index-label">{formatDate(post.data.date,lang)}</p><h3><a href={localizePath('/blog/'+slugOf(post.id),lang)}>{post.data.title} ↗</a></h3><p>{post.data.summary}</p></article>)}</div></section>
<section id="members" class="members-node"><p class="index-label">07 / {t.members}</p><div class="members-list">{members.map(member=><article><img {...(member.image.sprite?sprite(member.image.sprite,2):photo(member.image.photo,192))} alt={pick(member.alt,lang)} loading="lazy"/><div><h3>{pick(member.name,lang)}</h3><p class="member-role">{pick(member.role,lang)}</p><p>{pick(member.note,lang)}</p></div></article>)}</div></section>
<section id="contact" class="contact-node"><p class="index-label">09 / {en ? 'CONTACT' : '联系'}</p><p>{en ? 'always glad to get in touch!' : '随时欢迎联系！'}</p><a class="text-link" href="#about-contact">{en ? 'Email me' : '邮箱联系'} ↗</a><div class="contact-links">{profile.links.map(link=><a href={link.internal?localizePath(link.href,lang):link.href}>{pick(link.label,lang)} ↗</a>)}</div><a class="cv-download text-link" href="/cv/chi-zhang-cv.pdf">{en ? 'Curriculum vitae / PDF' : '个人简历 / PDF'} ↗</a></section>
</div>
</Spatial>
<script>
import '../../scripts/spatial.js'
</script>
