---
import Base from '../../layouts/Base.astro'
import { profile, education, interests } from '../../data/site.js'
import { awards, experience, teaching, service, skills } from '../../data/cv.js'
import { publications, posters, me } from '../../data/publications.js'
import { ui, pick } from '../../i18n/index.js'

const { lang } = Astro.props
const t = ui[lang]

// The PDF is generated by `npm run cv:pdf` and committed, so it is a plain
// static path rather than an import — Astro must not try to bundle it.
const PDF = '/cv/chi-zhang-cv.pdf'

// PDF open parameters, honoured by the embedded viewer and ignored elsewhere.
// Chrome's default chrome is a dark toolbar and a thumbnail rail, which is most
// of the width and none of the CV; the download and new-tab buttons above cover
// what the toolbar was for. FitH so the page fills the frame rather than sitting
// letterboxed in grey.
const EMBED = `${PDF}#toolbar=0&navpanes=0&view=FitH`

// Both lists on one page, newest first, since the CV runs them together too.
const written = [...publications, ...posters]
---

<Base lang={lang} path="/cv" title={t.nav.cv}>
  <section>
    <h1>{t.nav.cv}</h1>
    <p class="cv-actions">
      <a class="button" href={PDF} download>{t.downloadCV}</a>
      <a class="button" href={PDF} target="_blank" rel="noopener">{t.openCV}</a>
    </p>
  </section>

  {/* The PDF is the page, with the transcription below as the degraded path.
      Which one shows is decided twice: by width in CSS, because mobile browsers
      will not usefully embed a PDF, and by the script at the bottom, because a
      desktop browser with its PDF viewer switched off would otherwise render a
      tall empty box. The <object>'s own fallback is the last resort, for
      browsers too old to report either. */}
  <section class="cv-pdf">
    <object data={EMBED} type="application/pdf" aria-label={t.nav.cv}>
      <p class="stub-note">{t.cvNoEmbed}</p>
    </object>
  </section>

  <div class="cv-text">
  <section>
    <div class="panel">
      <h2>{t.education}</h2>
      <ul class="edu">
        {
          education.map((item) => (
            <li>
              <span class="school">{pick(item.school, lang)}</span>
              <span class="pixel when">{pick(item.when, lang)}</span>
              <span class="degree">{pick(item.degree, lang)}</span>
              <span class="where">{pick(item.where, lang)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section>
    <h2>{t.interests}</h2>
    <ul class="tags">
      {interests.map((item) => <li>{pick(item, lang)}</li>)}
    </ul>
  </section>

  <section>
    <div class="panel">
      <h2>{t.awards}</h2>
      <ul class="dated">
        {
          awards.map((item) => (
            <li>
              <span>{pick(item.what, lang)}</span>
              <span class="pixel when">{item.when}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section>
    <div class="panel">
      <h2>{t.researchExp}</h2>
      {
        experience.map((job) => (
          <article class="job">
            <h3>{pick(job.title, lang)}</h3>
            <span class="pixel when">{pick(job.when, lang)}</span>
            <p class="job-role">{pick(job.role, lang)}</p>
            <p class="job-where">{pick(job.where, lang)}</p>
            <ul>
              {job.bullets.map((b) => (
                <li>{pick(b, lang)}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  {/* The full list lives on /publications; repeating it here keeps the CV page
      usable as a CV, which is the thing people print or scroll end to end. */}
  <section>
    <div class="panel">
      <h2>{t.papers} · {t.posters}</h2>
      <ol class="pubs">
        {
          written.map((p) => (
            <li>
              <span class="pub-title">{p.title}</span>
              <span class="pub-authors">
                {p.authors.map((a, i) => (
                  <>
                    {i > 0 && ', '}
                    {a === me ? <strong>{a}</strong> : a}
                  </>
                ))}
              </span>
              <span class="pub-venue">
                {p.venue} · {p.year}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section>
    <div class="panel">
      <h2>{t.teaching}</h2>
      <ul class="dated">
        {
          teaching.map((item) => (
            <li>
              <span>{pick(item.what, lang)}</span>
              <span class="pixel when">{pick(item.when, lang)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section>
    <div class="panel">
      <h2>{t.service}</h2>
      <h3 class="sub">{pick(service.heading, lang)}</h3>
      <ul class="dated">
        {
          service.items.map((item) => (
            <li>
              <span>{pick(item.what, lang)}</span>
              <span class="pixel when">{item.when}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section>
    <div class="panel">
      <h2>{t.skills}</h2>
      <dl class="skills">
        {
          skills.map((row) => (
            <>
              <dt>{pick(row.group, lang)}</dt>
              <dd>{pick(row.items, lang)}</dd>
            </>
          ))
        }
      </dl>
    </div>
  </section>
  </div>
</Base>

<script is:inline>
  // Explicitly false only when the browser has a PDF viewer and it is turned
  // off, or has none at all — headless Chromium, Firefox set to always download,
  // a locked-down enterprise profile. Older browsers report undefined, which
  // leaves the CSS breakpoint in charge and the <object> fallback underneath it.
  if (navigator.pdfViewerEnabled === false) document.documentElement.dataset.noPdf = ''
</script>
